# =====================================================================
# DR. DOOM BACKEND CONFIGURATION
# =====================================================================

# Google Gemini API Key (Required for Multimodal Medical OCR & Clinical Reasoning)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated list for production / development)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Storage directory for SQLite records and document vault
STORAGE_DIR=storage
