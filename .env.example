# =====================================================================
# DR. DOOM - MONOREPO ENVIRONMENT TEMPLATE
# =====================================================================
# Copy this file to backend/.env and frontend/.env.local respectively

# --- BACKEND (backend/.env) ---
# Google Gemini API Key (Required for Multimodal Medical OCR & Clinical AI)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend Host & Port
HOST=0.0.0.0
PORT=8000

# Local Medical Vault & Database Directory
STORAGE_DIR=storage

# --- FRONTEND (frontend/.env.local) ---
# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
